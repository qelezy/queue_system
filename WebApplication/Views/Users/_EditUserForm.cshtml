@model EditUserViewModel

@{
    var updateUrlTemplate = "/api/user/__id__";
    var modalCloseId = ViewData["ModalCloseId"] as string;
}

<section class="register-panel">
    <header class="register-panel-head">
        <h2 class="register-panel-title">Редактирование пользователя</h2>
        @if (!string.IsNullOrWhiteSpace(modalCloseId))
        {
            <button type="button"
                    class="register-panel-close"
                    aria-label="Закрыть"
                    data-modal-close="@modalCloseId">
                ×
            </button>
        }
    </header>

    <form id="editUserForm" class="register-form" method="post" data-url-template="@updateUrlTemplate">
        <input type="hidden" id="EditUserId" value="@Model.Id" />

        <div class="register-fio-row">
            <div class="form-field">
                <label asp-for="LastName" class="field-required"></label>
                <input asp-for="LastName" id="EditLastName" required />
            </div>

            <div class="form-field">
                <label asp-for="FirstName" class="field-required"></label>
                <input asp-for="FirstName" id="EditFirstName" required />
            </div>

            <div class="form-field">
                <label asp-for="Patronymic"></label>
                <input asp-for="Patronymic" id="EditPatronymic" />
            </div>
        </div>

        <div class="form-field">
            <label asp-for="Email" class="field-required"></label>
            <input asp-for="Email" id="EditEmail" required />
        </div>

        <div class="form-field">
            <label asp-for="Role" class="field-required"></label>
            <select asp-for="Role" id="EditRole" required>
                <option value="Registrator">Регистратор</option>
                <option value="Manager">Менеджер</option>
                <option value="Admin">Администратор</option>
            </select>
        </div>

        <div class="register-actions">
            <button class="register-submit" type="submit">Сохранить изменения</button>
        </div>
    </form>
</section>
