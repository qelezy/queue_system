@using System.Text.Json
@{
    Layout = "_AuthForm";
    ViewData["Title"] = "Сброс пароля";
    var resetUrl = ViewData["ResetUrl"]?.ToString() ?? "";
    var token = ViewData["Token"]?.ToString() ?? "";
    var userId = ViewData["UserId"]?.ToString() ?? "";
    var loginPageUrl = Url.Action("Login", "Account") ?? "/Account/Login";
}

<form class="auth-form" id="resetForm">
    <p class="auth-form-subtitle">Задайте новый пароль для учетной записи</p>
    <div class="form-field">
        <label>Новый пароль</label>
        <input type="password" name="newPassword" required />
    </div>
    <div class="form-field">
        <label>Подтверждение пароля</label>
        <input type="password" name="confirmPassword" required />
    </div>
    <button type="submit">Сбросить пароль</button>
</form>

@section Scripts {
    <script>
        window.AppConfig = window.AppConfig || {};
        window.AppConfig.resetUrl = @Html.Raw(JsonSerializer.Serialize(resetUrl));
        window.AppConfig.resetUserId = @Html.Raw(JsonSerializer.Serialize(userId));
        window.AppConfig.resetToken = @Html.Raw(JsonSerializer.Serialize(token));
        window.AppConfig.loginPageUrl = @Html.Raw(JsonSerializer.Serialize(loginPageUrl));
    </script>
    <script src="~/js/account-reset-password.js" asp-append-version="true"></script>
}
