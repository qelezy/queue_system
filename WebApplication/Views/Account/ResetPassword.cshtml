@{
    Layout = "_AuthForm";
    ViewData["Title"] = "Сброс пароля";
    var resetUrl = ViewData["ResetUrl"];
    var token = ViewData["Token"];
    var userId = ViewData["UserId"];
}

<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

<form class="auth-form" id="resetForm">
    <div class="form-input">
        <label>Новый пароль</label>
        <input type="password" name="newPassword" required />
    </div>
    <button type="submit">Сбросить пароль</button>
</form>

<script>
    (function() {
        const form = document.getElementById('resetForm');

        form.addEventListener('submit', async e => {
            e.preventDefault();
            const newPassword = form.newPassword.value;
            const userId = '@userId';
            const passwordResetToken = '@token';

            try {
                const response = await fetch('@resetUrl', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ userId, passwordResetToken, newPassword })
                });

                const result = await response.json();

                if (response.ok && result.success) {
                    alert(result.message || "Пароль успешно изменен!");
                    window.location.href = '@Url.Action("Login", "Account")';
                } else {
                    const errors = result.errors?.join('\n') || "";
                    alert((result.message || "Ошибка сброса пароля") + (errors ? "\n" + errors : ""));
                }
            } catch (err) {
                console.error(err);
                alert("Сетевая ошибка при попытке сброса пароля");
            }
        });
    })();
</script>