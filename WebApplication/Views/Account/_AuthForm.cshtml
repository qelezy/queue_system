<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @await Component.InvokeAsync("ToastStack", new ToastStackViewModel
    {
        ContainerId = "global-toast-stack",
        MaxToasts = 3,
        AutoCloseMs = 3000
    })

    <div class="auth-wrapper">
        <div class="auth-form-container">
            <div class="auth-form-title">
                @ViewData["Title"]
            </div>
            @RenderBody()
        </div>
    </div>
    <script src="~/js/toast-stack.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>