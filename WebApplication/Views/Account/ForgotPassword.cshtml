@{
    Layout = "_AuthForm";
    ViewData["Title"] = "Забыли пароль?";
    var forgotUrl = ViewData["ForgotUrl"]?.ToString() ?? "";
}

<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

<form class="auth-form" id="forgotForm">
    <div class="form-input">
        <label>Email</label>
        <input type="email" name="email" required />
    </div>
    <button type="submit">Отправить ссылку</button>
</form>

<p class="auth-links">
    <a href="@Url.Action("Login", "Account")">
        Вернуться ко входу
    </a>
</p>

<script>
    (function() {
        const form = document.getElementById('forgotForm');

        form.addEventListener('submit', async e => {
            e.preventDefault();
            const email = form.email.value;

            try {
                const response = await fetch('@forgotUrl', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email })
                });

                const result = await response.json();

                if (response.ok && result.success) {
                    alert(result.message || "Ссылка для сброса пароля отправлена на ваш email.");
                } else {
                    const errors = result.errors?.join('\n') || "";
                    alert((result.message || "Ошибка запроса") + (errors ? "\n" + errors : ""));
                }
            } catch (err) {
                console.error(err);
                alert("Сетевая ошибка при попытке отправки запроса");
            }
        });
    })();
</script>