@{
    Layout = "_AuthForm";
    ViewData["Title"] = "Забыли пароль?";
    var forgotUrl = ViewData["ForgotUrl"]?.ToString() ?? "";
}

<form class="auth-form" id="forgotForm">
    <p class="auth-form-subtitle">Укажите email - отправим ссылку для сброса пароля</p>
    <div class="form-input">
        <label>Email</label>
        <input type="email" name="email" required />
    </div>
    <button type="submit">Отправить ссылку</button>
</form>

<p class="auth-links">
    <a href="@Url.Action("Login", "Account")">
        Вернуться ко входу
    </a>
</p>

@section Scripts {
    <script>
        window.AppConfig = window.AppConfig || {};
        window.AppConfig.forgotUrl = '@forgotUrl';
        window.AppConfig.forgotSuccessRedirect = '@Url.Action("Login", "Account")';
    </script>
    <script src="~/js/account-forgot-password.js" asp-append-version="true"></script>
}