@{
    Layout = "_AuthForm";
    ViewData["Title"] = "Подтверждение email";
    var userId = ViewData["UserId"]?.ToString() ?? "";
    var token = ViewData["Token"]?.ToString() ?? "";
    var confirmEmailUrl = ViewData["ConfirmEmailUrl"]?.ToString() ?? "";
}

<div class="auth-result" style="text-align:center;">
    <h2 id="status">Подтверждение email...</h2>
</div>

@section Scripts {
    <script>
        window.AppConfig = window.AppConfig || {};
        window.AppConfig.confirmEmailUrl = '@confirmEmailUrl';
        window.AppConfig.confirmEmailUserId = '@userId';
        window.AppConfig.confirmEmailToken = '@token';
        window.AppConfig.loginPageUrl = '@Url.Action("Login", "Account")';
    </script>
    <script src="~/js/account-confirm-email.js" asp-append-version="true"></script>
}