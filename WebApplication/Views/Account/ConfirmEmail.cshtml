@{
    var userId = ViewData["UserId"];
    var token = ViewData["Token"];
    var confirmEmailUrl = ViewData["ConfirmEmailUrl"]?.ToString() ?? "";
}

<div class="auth-result">
    <h2 id="status">Подтверждение email...</h2>
</div>

<script>
    (async () => {
        try {
            const response = await fetch('@confirmEmailUrl?userId=@userId&token=@token');

            const status = document.getElementById("status");

            const result = await response.json();

            if (response.ok && result.success) {
                status.innerText = result.message || "Email успешно подтвержден";
            } else {
                const errors = result.errors ? result.errors.join(", ") : "";
                status.innerText = result.message + (errors ? ": " + errors : "");
            }
        } catch (e) {
            document.getElementById("status").innerText =
                "Произошла ошибка при подключении к серверу.";
        }
    })();
</script>