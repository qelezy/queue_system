@{
    Layout = "_AuthForm";
    ViewData["Title"] = "Вход";
    var loginUrl = ViewData["LoginUrl"]?.ToString() ?? "";
}

<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

<form class="auth-form" id="loginForm">
    <div class="form-input">
        <label>Email</label>
        <input type="email" name="email" required />
    </div>
    <div class="form-input">
        <label>Пароль</label>
        <input type="password" name="password" required />
    </div>
    <div class="form-input remember-me">
        <input type="checkbox" id="rememberMe" name="rememberMe" />
        <label for="rememberMe">Запомнить меня</label>
    </div>
    <button type="submit">Войти</button>
</form>

<p class="auth-links">
    <a href="@Url.Action("ForgotPassword", "Account")">Забыли пароль?</a>
</p>

<script>
    (function() {
        const form = document.getElementById('loginForm');

        form.addEventListener('submit', async e => {
            e.preventDefault();
            const email = form.email.value;
            const password = form.password.value;

            try {
                const response = await fetch('@loginUrl', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email, password })
                });

                const result = await response.json();

                if (response.ok && result.success) {
                    localStorage.setItem("accessToken", result.data.token);
                    if (result.data.refreshToken)
                        localStorage.setItem("refreshToken", result.data.refreshToken);

                    const role = result.data.role || "";

                    if (role === "Admin") {
                        window.location.href = '/Admin';
                    } else if (role === "Doctor") {
                        window.location.href = '/Doctor';
                    } else {
                        window.location.href = '/';
                    }

                } else {
                    const errors = result.errors?.join('\n') || "";
                    alert((result.message || "Ошибка входа") + (errors ? "\n" + errors : ""));
                }
            } catch (err) {
                console.error(err);
                alert("Сетевая ошибка при попытке входа");
            }
        });
    })();
</script>