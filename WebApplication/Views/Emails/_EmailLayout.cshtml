@model WebApplication.Models.Emails.IEmailPageViewModel
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>@Model.Title</title>
    <style>
        :root {
            --primary-color: #00b3b8;
            --primary-soft: rgba(0, 179, 184, 0.12);
            --text-color: #333333;
            --color-white: #ffffff;
            --color-on-primary: #ffffff;
            --font-size-lg: 18px;
            --font-size-xl: 20px;
            --font-size-2xl: 24px;
            --font-size-3xl: 28px;
            --font-size-md: 17px;
            --radius-sm: 6px;
            --card-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        }
        html, body {
            margin: 0;
            padding: 0;
            background: var(--color-white);
            font-family: 'Poppins', Arial, Helvetica, sans-serif;
            color: var(--text-color);
            -webkit-text-size-adjust: 100%;
        }
        body {
            text-align: center;
        }
        .email-outer {
            width: 100%;
            border-collapse: collapse;
        }
        .email-outer__cell {
            padding: 24px 16px;
            text-align: center;
        }
        .email-card-shell {
            display: inline-block;
            width: 100%;
            max-width: 600px;
            border-radius: 16px;
            border: 1px solid rgba(0, 179, 184, 0.12);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            overflow: hidden;
            text-align: left;
        }
        .email-card {
            width: 100%;
            border-collapse: collapse;
            border-spacing: 0;
        }
        .email-header {
            background-color: var(--primary-color);
            padding: 28px 32px;
        }
        .email-header__title {
            margin: 0;
            font-size: var(--font-size-3xl);
            font-weight: 600;
            line-height: 1.3;
            color: var(--color-on-primary);
            text-align: left;
        }
        .email-content {
            padding: 36px 32px;
            background: var(--color-white);
        }
        .email-body {
            font-size: var(--font-size-lg);
            line-height: 1.55;
            color: var(--text-color);
            text-align: left;
        }
        .email-body p {
            margin: 0 0 16px;
        }
        .email-body p:last-child {
            margin-bottom: 0;
        }
        .email-password-row {
            text-align: center;
            margin: 0 0 16px;
        }
        .email-password {
            display: inline-block;
            padding: 10px 16px;
            margin: 0;
            background: var(--primary-soft);
            border-radius: var(--radius-sm);
            font-weight: 600;
            font-size: var(--font-size-2xl);
            color: var(--text-color);
            word-break: break-all;
        }
        .email-hint {
            margin: 0 0 16px;
            padding: 12px 16px;
            background: #fff8e8;
            border-left: 4px solid #d4a017;
            border-radius: var(--radius-sm);
            font-size: var(--font-size-md);
            line-height: 1.5;
            color: #6b5420;
        }
        .email-btn-wrap {
            margin: 24px 0 0;
            text-align: center;
        }
        .email-btn {
            display: block;
            width: 100%;
            box-sizing: border-box;
            padding: 14px 28px;
            font-size: var(--font-size-xl);
            font-weight: 500;
            color: var(--color-on-primary) !important;
            background-color: var(--primary-color);
            border-radius: var(--radius-sm);
            text-decoration: none;
            text-align: center;
        }
    </style>
</head>
<body>
    <table class="email-outer" role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
        <tr>
            <td class="email-outer__cell" align="center">
                <div class="email-card-shell">
                    <table class="email-card" role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                        <tr>
                            <td class="email-header">
                                <h1 class="email-header__title">@Model.Title</h1>
                            </td>
                        </tr>
                        <tr>
                            <td class="email-content">
                                <div class="email-body">
                                    @RenderBody()
                                </div>
                            </td>
                        </tr>
                    </table>
                </div>
            </td>
        </tr>
    </table>
</body>
</html>
