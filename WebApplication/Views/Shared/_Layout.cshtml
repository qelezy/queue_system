<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/base/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/base/variables.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/base/reset.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/forms.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/buttons.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/checkbox.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/tables.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/tabs.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/modals.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/toast.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/toolbar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/alerts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/utilities.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout/shell.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    @await Component.InvokeAsync("ToastStack", new ToastStackViewModel
    {
        ContainerId = "global-toast-stack",
        MaxToasts = 3,
        AutoCloseMs = 3000
    })

    <div class="app-shell">
        @await Component.InvokeAsync("Sidebar")

        <div class="main-area">
            <header class="top-bar">
                <span class="top-bar-title">@ViewData["Title"]</span>
                @await RenderSectionAsync("TopBarRight", required: false)
            </header>

            <main class="content-pad">
                @RenderBody()
            </main>
        </div>

    </div>

    <script src="~/js/toast-stack.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
