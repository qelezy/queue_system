@model TableToolbarViewModel

<div class="table-toolbar">
    <div class="table-toolbar__left">
        @await Component.InvokeAsync("SearchBox", Model.Search)

        @if (Model.Filter is not null)
        {
            <div class="toolbar-role-filter">
                <select id="@Model.Filter.SelectId"
                        class="toolbar-role-filter__select"
                        onchange="@Model.Filter.OnChange">
                    <option value="">@Model.Filter.AllLabel</option>
                    @foreach (var option in Model.Filter.Options)
                    {
                        <option value="@option.Value">@option.Label</option>
                    }
                </select>
            </div>
        }

        @if (Model.ShowArchivedToggle)
        {
            <label class="table-toolbar__archived-toggle">
                <input type="checkbox"
                       class="app-checkbox"
                       id="@Model.ArchivedToggleInputId"
                       onchange="@Model.ArchivedToggleOnChange" />
                <span>Показать архивные</span>
            </label>
        }
    </div>

    <div class="table-toolbar__right">
        <button class="btn btn-primary"
                type="button"
                onclick="@Model.CreateButtonOnClick">
            <i class="bi @Model.CreateButtonIcon"></i>
            @Model.CreateButtonText
        </button>
    </div>
</div>
