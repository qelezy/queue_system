@model ReportResultViewModel

<div class="users-table-wrap">
    <table class="users-table" aria-label="@Model.Title">
        <thead>
            <tr>
                @foreach (var h in Model.ColumnHeaders)
                {
                    <th>@h</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Rows)
            {
                <tr class="@row.RowClass">
                    @for (var i = 0; i < row.Cells.Count; i++)
                    {
                        var span = row.CellColSpans is not null && i < row.CellColSpans.Count ? row.CellColSpans[i] : 1;
                        if (span == 0)
                        {
                            continue;
                        }

                        if (span > 1)
                        {
                            <td colspan="@span">@row.Cells[i]</td>
                        }
                        else
                        {
                            <td>@row.Cells[i]</td>
                        }
                    }
                </tr>
            }
        </tbody>
    </table>
</div>
