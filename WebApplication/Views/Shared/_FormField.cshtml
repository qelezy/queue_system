@model FormFieldModel

@if (Model == null)
{
    return;
}

<div class="form-field">

    <label>
        @Model.Label
        @if (Model.Required)
        {
            <span class="field-required" aria-hidden="true">*</span>
        }
    </label>

    @switch (Model.Type)
    {
        case "text":
            <input type="text" name="@Model.Name" value="@Model.Value" />
            break;

        case "email":
            <input type="email" name="@Model.Name" value="@Model.Value" />
            break;

        case "password":
            <input type="password" name="@Model.Name" value="@Model.Value" />
            break;

        case "select":
            <select name="@Model.Name">
                @foreach (var option in Model.Options)
                {
                    <option value="@option.Value" selected="@option.Selected">
                        @option.Text
                    </option>
                }
            </select>
            break;
    }

</div>