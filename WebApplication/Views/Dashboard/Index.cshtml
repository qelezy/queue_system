@using WebApplication.Models
@model DashboardViewModel

@section Head {
    <link rel="stylesheet" href="~/css/features/dashboard.css" asp-append-version="true" />
}

<div class="dashboard-monitoring-page">
    @if (ViewData["QueueDatabaseUnavailable"] is true)
    {
        <div class="alert alert-warning mb-3" role="alert">
            База данных электронной очереди недоступна.
        </div>
    }
    else
    {
    <div class="stats-row"
         data-dashboard-live
         data-ui-waiting="@Model.Ui.WaitingCard.ToString().ToLowerInvariant()"
         data-ui-in-service="@Model.Ui.InServiceCard.ToString().ToLowerInvariant()"
         data-ui-accepted-today="@Model.Ui.AcceptedTodayCard.ToString().ToLowerInvariant()"
         data-ui-avg-wait="@Model.Ui.AvgWaitCard.ToString().ToLowerInvariant()"
         data-ui-avg-service="@Model.Ui.AvgServiceCard.ToString().ToLowerInvariant()"
         data-ui-queue-table="@Model.Ui.QueueTable.ToString().ToLowerInvariant()"
         data-ui-doctor-load="@Model.Ui.DoctorLoad.ToString().ToLowerInvariant()">
        @if (Model.Ui.WaitingCard)
        {
            <partial name="_StatCard" model="@(new StatCardViewModel {
                DataStatKey = "waiting",
                Label = "Ожидают",
                Value = Model.WaitingCount.ToString(),
                Unit = "",
                Hint = "пациенты, ожидающие приёма"
            })" />
        }
        @if (Model.Ui.InServiceCard)
        {
            <partial name="_StatCard" model="@(new StatCardViewModel {
                DataStatKey = "in-service",
                Label = "На приёме",
                Value = Model.InServiceCount.ToString(),
                Unit = "",
                Hint = "пациенты, находящиеся на приёме"
            })" />
        }
        @if (Model.Ui.AcceptedTodayCard)
        {
            <partial name="_StatCard" model="@(new StatCardViewModel {
                DataStatKey = "accepted-today",
                Label = "Обслужено",
                Value = Model.AcceptedTodayCount.ToString(),
                Unit = "",
                Hint = "пациенты с завершённым маршрутом"
            })" />
        }
        @if (Model.Ui.AvgWaitCard)
        {
            <partial name="_StatCard" model="@(new StatCardViewModel {
                DataStatKey = "avg-wait",
                Label = "Среднее время ожидания",
                Value = Model.AvgWaitMinutes.ToString(),
                Unit = "мин",
                SubLabel = "Максимум",
                SubValue = Model.MaxWaitMinutes.ToString(),
                SubUnit = "мин",
                Hint = "по завершённым ожиданиям за сегодня"
            })" />
        }
        @if (Model.Ui.AvgServiceCard)
        {
            <partial name="_StatCard" model="@(new StatCardViewModel {
                DataStatKey = "avg-service",
                Label = "Средняя длительность приёма",
                Value = Model.AvgServiceMinutes.ToString(),
                Unit = "мин",
                SubLabel = "Максимум",
                SubValue = Model.MaxServiceMinutes.ToString(),
                SubUnit = "мин",
                Hint = "по завершённым приёмам за сегодня"
            })" />
        }
    </div>

    @if (Model.Ui.DoctorLoad)
    {
        <partial name="_DashboardDoctorLoad" model="@(new DashboardDoctorLoadViewModel { Cards = Model.DoctorLoadCards, Filters = Model.QueueFilters })" />
    }
    @if (Model.Ui.QueueTable)
    {
        <partial name="_DashboardQueueTable" model="@(new DashboardQueueTableViewModel { Rows = Model.ActiveQueue, Filters = Model.QueueFilters })" />
        <partial name="_DashboardCompletedStagesModal" />
    }
    }
</div>

@section Scripts {
    @if (ViewData["QueueDatabaseUnavailable"] is not true)
    {
        <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
        <script src="~/js/dashboard-live.js" asp-append-version="true"></script>
    }
    <script src="~/js/dashboard-doctor-load.js" asp-append-version="true"></script>
    <script src="~/js/dashboard-queue.js" asp-append-version="true"></script>
    @if (Model.Ui.QueueTable && ViewData["QueueDatabaseUnavailable"] is not true)
    {
        <script src="~/js/dashboard-queue-stages.js" asp-append-version="true"></script>
    }
}
