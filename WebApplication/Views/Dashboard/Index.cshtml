@using WebApplication.Models
@model DashboardViewModel
@{
    var labels         = System.Text.Json.JsonSerializer.Serialize(Model.DailyLabels);
    var waitData       = System.Text.Json.JsonSerializer.Serialize(Model.DailyWaitMinutes);
    var serveData      = System.Text.Json.JsonSerializer.Serialize(Model.DailyServiceMinutes);
    var cabNames       = System.Text.Json.JsonSerializer.Serialize(Model.Cabinets.Select(c => c.Name));
    var cabLoads       = System.Text.Json.JsonSerializer.Serialize(Model.Cabinets.Select(c => c.LoadPercent));
}

@section Head {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
}

<div class="stats-row">
    <partial name="_StatCard" model="@(new StatCardViewModel {
        Label = "Всего ожидают",
        Value = Model.WaitingCount.ToString(),
        Hint = "в очереди сейчас"
    })" />
    <partial name="_StatCard" model="@(new StatCardViewModel {
        Label = "Всего на приёме сейчас",
        Value = Model.InServiceCount.ToString(),
        Hint = "по всем кабинетам"
    })" />
    <partial name="_StatCard" model="@(new StatCardViewModel {
        Label = "Среднее время ожидания (сегодня)",
        Value = Model.AvgWaitMinutes.ToString(),
        Unit = "мин",
        Hint = "по завершённым этапам ожидания"
    })" />
    <partial name="_StatCard" model="@(new StatCardViewModel {
        Label = "Средняя длительность приёма (сегодня)",
        Value = Model.AvgServiceMinutes.ToString(),
        Unit = "мин",
        Hint = "по завершённым приёмам"
    })" />
</div>

<div class="bottom-grid">
    <partial name="_ChartCard" model="@(new ChartCardViewModel {
        Title = "Среднее время ожидания и длительность приёма по дням (мин)",
        CanvasId = "chartWaitServe"
    })" />
    <partial name="_ChartCard" model="@(new ChartCardViewModel {
        Title = "Загрузка кабинетов (% занятого времени, неделя)",
        CanvasId = "chartCabinets"
    })" />
</div>

@section Scripts {
<script>
    Chart.defaults.font.family = "'Poppins', sans-serif";
    Chart.defaults.color = '#555';

    var teal     = '#00b3b8';
    var tealDark = '#0d3d40';
    var amber    = '#c9a227';

    new Chart(document.getElementById('chartWaitServe'), {
        type: 'line',
        data: {
            labels: @Html.Raw(labels),
            datasets: [
                {
                    label: 'Ожидание, мин',
                    data: @Html.Raw(waitData),
                    borderColor: teal,
                    backgroundColor: 'rgba(0,179,184,0.12)',
                    fill: true, tension: 0.35, pointRadius: 4
                },
                {
                    label: 'Приём, мин',
                    data: @Html.Raw(serveData),
                    borderColor: amber,
                    backgroundColor: 'rgba(201,162,39,0.08)',
                    fill: true, tension: 0.35, pointRadius: 4
                }
            ]
        },
        options: {
            responsive: true, maintainAspectRatio: false,
            plugins: { legend: { position: 'top', align: 'end' } },
            scales: {
                y: { beginAtZero: true, title: { display: true, text: 'Минуты' }, grid: { color: 'rgba(0,0,0,0.06)' } },
                x: { grid: { display: false } }
            }
        }
    });

    new Chart(document.getElementById('chartCabinets'), {
        type: 'bar',
        data: {
            labels: @Html.Raw(cabNames),
            datasets: [{
                label: 'Загрузка, %',
                data: @Html.Raw(cabLoads),
                backgroundColor: [
                    'rgba(0,179,184,0.75)','rgba(0,179,184,0.55)','rgba(0,179,184,0.65)',
                    'rgba(13,61,64,0.85)','rgba(0,179,184,0.5)','rgba(13,61,64,0.65)'
                ],
                borderRadius: 6
            }]
        },
        options: {
            indexAxis: 'y', responsive: true, maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                x: { max: 100, beginAtZero: true, title: { display: true, text: '%' }, grid: { color: 'rgba(0,0,0,0.06)' } },
                y: { grid: { display: false } }
            }
        }
    });
</script>
}
