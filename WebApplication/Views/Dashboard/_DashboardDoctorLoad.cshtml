@model DashboardDoctorLoadViewModel

@{
    var delaysCount = Model.Cards.Count(d =>
        d.IsInService && d.NormServiceMinutes is int n && d.CurrentServiceMinutes is int c && c > n);
}

<div class="dashboard-panel">
    <h3 class="dashboard-panel__title doctor-load-panel__title">
        <span class="doctor-load-panel__title-text">Состояние врачей</span>
        <span class="doctor-load-shift-badge" aria-label="На смене: @Model.DoctorsOnShiftCount из @Model.DoctorsTotalCount">На смене: @Model.DoctorsOnShiftCount/@Model.DoctorsTotalCount</span>
        @if (delaysCount > 0)
        {
            <span class="doctor-load-delays-badge" aria-label="Задержек: @delaysCount">Задержек: @delaysCount</span>
        }
    </h3>

    <div class="table-toolbar doctor-load-toolbar">
        <div class="table-toolbar__left">
            @await Component.InvokeAsync("SearchBox", new SearchBoxViewModel
            {
                InputId = "doctor-state-search-input",
                Placeholder = "Поиск",
                OnInput = "DoctorLoadTable.filter(this.value)"
            })
            <div class="toolbar-role-filter">
                <select id="doctor-filter-specialty" class="toolbar-role-filter__select" onchange="DoctorLoadTable.filterSpecialty(this.value)">
                    <option value="">Все специальности</option>
                    @foreach (var s in Model.Filters.Specialties)
                    {
                        <option value="@s.Id">@s.Label</option>
                    }
                </select>
            </div>
            <div class="toolbar-role-filter">
                <select id="doctor-filter-status" class="toolbar-role-filter__select" onchange="DoctorLoadTable.filterStatus(this.value)">
                    <option value="">Все статусы</option>
                    <option value="in-service">Принимает</option>
                    <option value="free">Ожидает пациента</option>
                </select>
            </div>
        </div>
    </div>

    <div class="users-table-wrap doctor-load-table-scroll">
        <table class="users-table doctor-load-table" aria-label="Состояние врачей">
            <thead>
                <tr>
                    <th>Врач</th>
                    <th>Статус</th>
                    <th>Текущий приём</th>
                    <th>Норма</th>
                    <th>В очереди</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Cards.Count == 0)
            {
                <tr><td colspan="5">Нет активных врачей</td></tr>
            }
            else
            {
                foreach (var d in Model.Cards)
                {
                    var hasCurrent = d.IsInService && d.CurrentServiceMinutes.HasValue;
                    var hasNorm = d.NormServiceMinutes.HasValue;
                    var norm = d.NormServiceMinutes ?? 0;
                    var cur = d.CurrentServiceMinutes ?? 0;
                    var over = hasCurrent && hasNorm && cur > norm;
                    <tr data-doctor-load-row data-doctor-id="@d.IdDoctor" data-doctor-status="@(d.IsInService ? "in-service" : "free")" data-specialty-id="@d.IdSpecialty">
                        <td>
                            <div class="queue-row__doctor-name">@d.FullName</div>
                            <div class="queue-row__doctor-specialty">@d.Specialty@(string.IsNullOrEmpty(d.Cabinet) ? "" : " · " + d.Cabinet)</div>
                        </td>
                        <td>
                            @if (d.IsInService)
                            {
                                <span class="queue-status-badge queue-status-badge--in-service">Принимает</span>
                            }
                            else
                            {
                                <span class="queue-status-badge queue-status-badge--free">Ожидает пациента</span>
                            }
                        </td>
                        <td class="@(over ? "doctor-load-table__cell--over" : "")">
                            @(hasCurrent ? $"{cur} мин" : "—")
                        </td>
                        <td>
                            @(hasNorm ? $"{norm} мин" : "—")
                        </td>
                        <td>@d.QueueLength</td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
