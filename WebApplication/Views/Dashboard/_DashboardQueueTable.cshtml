@model DashboardQueueTableViewModel

<div class="dashboard-panel">
    <h3 class="dashboard-panel__title queue-panel__title">
        <span class="queue-panel__title-text">Лист ожидания</span>
    </h3>

    <div class="table-toolbar queue-toolbar">
        <div class="table-toolbar__left">
            @await Component.InvokeAsync("SearchBox", new SearchBoxViewModel
            {
                InputId = "queue-search-input",
                Placeholder = "Поиск",
                OnInput = "QueueTable.search(this.value)"
            })
            <div class="toolbar-role-filter">
                <select id="queue-filter-category" class="toolbar-role-filter__select" onchange="QueueTable.filterCategory(this.value)">
                    <option value="">Все категории</option>
                    @foreach (var c in Model.Filters.Categories)
                    {
                        <option value="@c.Id">@c.Label</option>
                    }
                </select>
            </div>
            <div class="toolbar-role-filter">
                <select id="queue-filter-status" class="toolbar-role-filter__select" onchange="QueueTable.filterStatus(this.value)">
                    <option value="">Все статусы</option>
                    <option value="waiting">Ожидает</option>
                    <option value="called">Вызван</option>
                </select>
            </div>
            <div class="queue-wait-filter">
                <input type="number" min="0" inputmode="numeric"
                       class="toolbar-wait-input"
                       placeholder="Время ожидания > мин"
                       oninput="QueueTable.filterWait(this.value)" />
            </div>
        </div>
    </div>

    <div class="users-table-wrap queue-table-scroll">
        <table class="users-table dashboard-table queue-table" aria-label="Лист ожидания">
            <colgroup>
                <col class="queue-table__col-ticket" />
                <col class="queue-table__col-needed" />
                <col class="queue-table__col-completed" />
                <col class="queue-table__col-category" />
                <col class="queue-table__col-status" />
                <col class="queue-table__col-wait" />
            </colgroup>
            <thead>
                <tr>
                    <th>№ талона</th>
                    <th>Нужно пройти специальностей</th>
                    <th>Пройдено специальностей</th>
                    <th>Категория обслуживания</th>
                    <th>Статус</th>
                    <th>Время ожидания</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Rows.Count == 0)
            {
                <tr class="users-table__empty-row"><td colspan="6">Лист ожидания пуст</td></tr>
            }
            else
            {
                foreach (var r in Model.Rows)
                {
                    <tr class="queue-row--clickable"
                        data-queue-row
                        data-appointment-id="@r.IdAppointment"
                        data-category-id="@(r.IdCategory?.ToString() ?? "")"
                        data-status-code="@r.StatusCode"
                        data-wait="@r.WaitingMinutes"
                        tabindex="0"
                        role="button"
                        aria-label="Этапы обслуживания талона @r.TicketNumber">
                        <td>@r.TicketNumber</td>
                        <td>@r.NeededSpecialtiesCount</td>
                        <td>@r.CompletedSpecialtiesCount</td>
                        <td>@r.CategoryName</td>
                        <td>
                            <span class="queue-status-badge queue-status-badge--@r.StatusCode">@r.StatusLabel</span>
                        </td>
                        <td>@r.WaitingMinutes мин</td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
