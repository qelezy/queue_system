@{
    const string modalId = "doctor-patients-modal";
}

<div id="@modalId"
     class="app-modal doctor-patients-modal"
     aria-hidden="true">
    <div class="app-modal__overlay" data-modal-close="@modalId"></div>
    <div class="app-modal__dialog doctor-patients-modal__dialog"
         role="dialog"
         aria-modal="true"
         aria-labelledby="doctor-patients-modal-title"
         tabindex="-1">
        <div class="app-modal__body">
            <section class="register-panel doctor-patients-panel">
                <header class="register-panel-head">
                    <h2 class="register-panel-title" id="doctor-patients-modal-title">Потенциальные пациенты</h2>
                    <button type="button"
                            class="register-panel-close"
                            aria-label="Закрыть"
                            data-modal-close="@modalId">
                        ×
                    </button>
                </header>

                <div class="users-table-wrap doctor-patients-table-scroll">
                    <table class="users-table doctor-patients-table" aria-label="Потенциальные пациенты">
                        <colgroup>
                            <col class="doctor-patients-table__col-ticket" />
                            <col class="doctor-patients-table__col-category" />
                            <col class="doctor-patients-table__col-priority" />
                            <col class="doctor-patients-table__col-wait" />
                        </colgroup>
                        <thead>
                            <tr>
                                <th>Талон</th>
                                <th>Категория обслуживания</th>
                                <th>Приоритет</th>
                                <th>Время ожидания</th>
                            </tr>
                        </thead>
                        <tbody id="doctor-patients-tbody">
                            <tr class="users-table__empty-row"><td colspan="4">Загрузка…</td></tr>
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    </div>
</div>
